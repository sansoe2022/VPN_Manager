#!/bin/bash

fun_online() {
    # 1. SSH Users
    _ons=$(ps -x | grep sshd | grep -v root | grep priv | wc -l)

    # 2. OpenVPN Users (/etc/openvpn/server/openvpn-status.log)
    if [[ -e /etc/openvpn/server/openvpn-status.log ]]; then
        _onop=$(grep -c "10.8.0" /etc/openvpn/server/openvpn-status.log)
    elif [[ -e /etc/openvpn/openvpn-status.log ]]; then
        _onop=$(grep -c "10.8.0" /etc/openvpn/openvpn-status.log)
    else
        _onop=0
    fi

    # စုစုပေါင်း Online User တွက်ချက်ခြင်း (SSH + OpenVPN သီးသန့်)
    _onli=$(($_ons + $_onop))

    echo "{\"onlines\":\"$_onli\",\"limite\":\"2500\"}" > /var/www/html/server/online_app
    echo "$_onli" > /var/www/html/server/online
}

while true; do
    fun_online > /dev/null 2>&1
    sleep 15s
done
